{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "allowImportingTsExtensions": true,
    "strict": true, "noEmit": true, "skipLibCheck": true, "jsx": "react-jsx", "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
